[1.313, "o", "\u001b[6;2Hdatabase\u001b[6;10H"]
[1.328, "o", "\u001b[6;10H\r\n"]
[1.344, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[1.672, "o", "\r\n***База данных***"]
[1.688, "o", "\r\n"]
[1.688, "o", "\r\nУправление таблицами:"]
[1.688, "o", "\r\n"]
[1.688, "o", "  create_table <таблица> <столбец:тип> ... — создать таблицу\r\n  list_tables — показать все таблицы\r\n  drop_table <таблица> — удалить таблицу\r\n\r\nОперации с данными:"]
[1.703, "o", "\r\n  insert into <таблица> values (<значение>, ...) — добавить запись\r\n  select from <таблица> [where <столбец> = <значение>] — выбрать записи\r\n  update <таблица> set <столбец> = <значение> where <условие> — изменить\r\n"]
[1.703, "o", "  delete from <таблица> where <столбец> = <значение> — удалить записи\r\n  info <таблица> — показать структуру и количество записей\r\n\r\nТипы: int, str, bool. Строковые значения вводятся в кавычках.\r\n  help — справка\r\n  exit — выход\r\n"]
[1.703, "o", "\r\n>>> Введите команду: "]
[2.922, "o", "\u001b[26;22Hcreate_table users name:str age:int is_active:bool\u001b[26;72H"]
[2.922, "o", "\u001b[26;72H\r\n"]
[2.922, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[2.922, "o", "\r\n>>> Введите команду: "]
[4.203, "o", "\u001b[29;22Hinsert into users values (\"Sergei\", 28, true)\u001b[29;67H"]
[4.203, "o", "\u001b[29;67H\r\n"]
[4.203, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[4.203, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[4.219, "o", "\r\n>>> Введите команду: "]
[5.422, "o", "\u001b[33;22Hinsert into users values (\"Anna\", 24, false)\u001b[33;66H"]
[5.422, "o", "\u001b[33;66H\r\n"]
[5.438, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[5.438, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[5.438, "o", "\r\n>>> Введите команду: "]
[6.672, "o", "\u001b[35;22Hselect from users\u001b[35;39H"]
[6.688, "o", "\u001b[35;39H\r\n"]
[6.688, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[6.781, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  24 |   False   |\r\n+----+--------+-----+-----------+"]
[6.781, "o", "\r\n"]
[6.781, "o", "\r\n>>> Введите команду: "]
[8.016, "o", "\u001b[35;22Hselect from users where age = 28\u001b[35;54H"]
[8.016, "o", "\u001b[35;54H\r\n"]
[8.016, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[8.016, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[8.016, "o", "\r\n"]
[8.016, "o", "\r\n>>> Введите команду: "]
[9.25, "o", "\u001b[35;22Hselect from users where age = 28\u001b[35;54H"]
[9.25, "o", "\u001b[35;54H\r\n"]
[9.25, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.25, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[9.266, "o", "\r\n"]
[9.266, "o", "\r\n>>> Введите команду: "]
[10.485, "o", "\u001b[35;22Hupdate users set age = 29, is_active = false where name = \"Sergei\"\u001b[35;88H"]
[10.485, "o", "\u001b[35;88H\r\n"]
[10.485, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[10.485, "o", "\r\n>>> Введите команду: "]
[11.703, "o", "\u001b[35;22Hselect from users where ID = 1\u001b[35;52H"]
[11.719, "o", "\u001b[35;52H\r\n"]
[11.719, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.719, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |   False   |\r\n+----+--------+-----+-----------+"]
[11.719, "o", "\r\n\r\n>>> Введите команду: "]
[12.938, "o", "\u001b[35;22Hinsert into users values (\"Wrong\", \"twenty\", true)\u001b[35;72H"]
[12.938, "o", "\u001b[35;72H\r\n"]
[12.953, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[12.953, "o", "Ошибка валидации: Столбец \"age\" должен иметь тип int.\r\n\r\n>>> Введите команду: "]
[14.188, "o", "\u001b[35;22Hdelete from users where ID = 2\u001b[35;52H"]
[14.188, "o", "\u001b[35;52H\r\n"]
[14.188, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.188, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[15.422, "o", "\u001b[35;61Hn\u001b[35;62H"]
[15.422, "o", "\u001b[35;62H"]
[15.422, "o", "\r\n"]
[15.422, "o", "Операция отменена.\r\n"]
[15.422, "o", "\r\n>>> Введите команду: "]
