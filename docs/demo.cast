[16.672, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[16.672, "o", "Количество записей: 2\r\n\r\n>>> Введите команду: "]
[17.906, "o", "\u001b[35;22Hdelete from users where ID = 2\u001b[35;52H"]
[17.906, "o", "\u001b[35;52H\r\n"]
[17.906, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[17.906, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
